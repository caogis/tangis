# TangGIS 本地开发环境配置
# 复制为 deploy/.env 后按需修改: cp deploy/.env.example deploy/.env

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=tangis
POSTGRES_USER=tangis
POSTGRES_PASSWORD=tangis_dev_password
POSTGRES_PORT=15432

# --- Redis ---
REDIS_PORT=16379

# --- MinIO (对象存储, 瓦片/源数据) ---
MINIO_ROOT_USER=tangis
MINIO_ROOT_PASSWORD=tangis_dev_secret
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# --- NATS JetStream (任务队列) ---
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222

# --- apiserver 缓存 (F-03, server 进程环境变量, 非 compose) ---
# Redis 地址（瓦片/列表响应缓存），未设置回退 REDIS_ADDR，再回退 127.0.0.1:16379
#TANGIS_REDIS_ADDR=127.0.0.1:16379
# 瓦片响应缓存 TTL（秒），默认 300
#TANGIS_CACHE_TTL=300
# 任务/服务列表缓存 TTL（秒），默认 5；负数禁用列表缓存
#TANGIS_LIST_CACHE_TTL=5
